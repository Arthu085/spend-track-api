# API runtime settings, passed to the api container as DEPLOY_PATH/api.env. The deploy workflow
# renders it from GitHub Variables and Secrets. compose.yml sets NODE_ENV, PORT, TRUST_PROXY,
# APP_WEB_URL, CORS_ORIGINS, COOKIE_SECURE, COOKIE_DOMAIN, and DB_* itself. Every other variable in
# the repository's .env.example may be added here. Docker reads values literally: do not quote them.

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECRET=
COOKIE_SAMESITE=lax

DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=30000

# SMTP provider, or MAIL_HOST=mailpit, MAIL_PORT=1025, MAIL_SECURE=false with COMPOSE_PROFILES=mail.
MAIL_TRANSPORT=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Spend Track <no-reply@spendtrack.com>

LOG_LEVEL=info
LOG_PRETTY=false
