# Server settings in DEPLOY_PATH/.env: Compose interpolation and backups; no container receives this
# file as a whole. The deploy workflow renders it from GitHub Variables and Secrets, and
# scripts/deploy.sh adds API_IMAGE. API variables go in DEPLOY_PATH/api.env (see the root .env.example).
# Values are read literally: do not quote them.

# Public hostname served by Caddy; its DNS A/AAAA records must point to this server.
APP_DOMAIN=app.example.com
# Let's Encrypt account email for certificate expiry notices.
ACME_EMAIL=ops@example.com

# PostgreSQL superuser password, applied when the postgres container initializes an empty volume.
POSTGRES_PASSWORD=
# API database, role, and password. The role is created on the first start of an empty volume;
# changing these later requires ALTER ROLE / ALTER DATABASE (see docs/deployment.md).
DB_NAME=spend_track
DB_USER=spend_track
DB_PASSWORD=

# Optional services: "mail" starts Mailpit as a temporary SMTP sink (set MAIL_HOST=mailpit in api.env).
COMPOSE_PROFILES=

# Backups (scripts/backup.sh). BACKUP_REMOTE is an rclone remote and path from rclone/rclone.conf,
# such as offsite:spend-track-backups; leave it empty to keep dumps on this server only. 0 keeps every dump.
BACKUP_RETENTION_DAYS=7
BACKUP_REMOTE=
BACKUP_REMOTE_RETENTION_DAYS=30
