# App
NODE_ENV=development
PORT=3000
DEFAULT_LOCALE=pt-BR

# Reverse proxy trust (Express "trust proxy"). Decides which X-Forwarded-For hops
# are trusted when resolving the client IP used by rate limiting, audit logs, and
# error logs. Leave false when clients connect directly (local development).
# Behind a reverse proxy/load balancer, set either:
#   - a hop count: the number of proxies in front of the API (e.g. 1), or
#   - a comma-separated list of proxy addresses: IPs, CIDR ranges, or the presets
#     loopback | linklocal | uniquelocal (e.g. loopback,10.0.0.0/8).
# "true" is rejected: it would trust any client-supplied X-Forwarded-For.
TRUST_PROXY=false

# Database (Postgres)
# DB_HOST must be "postgres" when running via docker-compose (Docker network service name),
# or "localhost" when running the API outside Docker against the compose-managed database.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=spend_track

# Managed Postgres (RDS, Cloud SQL, Neon, Supabase, ...). The defaults suit the
# local compose database; a managed host typically needs DB_SSL=true.
# DB_SSL is the only TLS switch (PGSSLMODE is ignored).
# DB_SSL=true encrypts the connection and verifies the server certificate against
# Node's CA store; for a provider-specific CA (e.g. the RDS bundle) point
# NODE_EXTRA_CA_CERTS at the CA file instead of disabling verification.
# DB_POOL_MAX caps open connections per API process (pg default 10); keep
# instances x DB_POOL_MAX below the host's connection limit.
# DB_STATEMENT_TIMEOUT_MS aborts any statement running longer than this; 0 sends
# no timeout, so the server/role setting applies. Behind a transaction pooler
# (PgBouncer, pooled Neon/Supabase endpoints) keep 0 and set it per role instead.
DB_SSL=false
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=0

# Auth
# Production rejects the change-me values below: JWT_ACCESS_SECRET, JWT_REFRESH_SECRET
# and COOKIE_SECRET must each be at least 32 characters, must not contain placeholder
# markers (change-me, replace-me, placeholder), and the access and refresh secrets must differ.
# Generate one with: openssl rand -base64 48
# JWT_*_TTL: an integer with an optional unit (ms, s, m, h, d); no unit means milliseconds.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=7d

# Revoked refresh-token rows are purged by an hourly cleanup job once they are
# older than this many days; the same job also purges every expired row. 0 disables the job.
REFRESH_TOKEN_RETENTION_DAYS=30

# Seed admin (created by `npm run seed`, attached to the ADMIN role)
# Enabled by default outside production; in production it is skipped unless
# SEED_ADMIN_ENABLED=true. The password must contain an uppercase letter, a
# lowercase letter, a digit, and a symbol. Production also rejects known default
# emails and weak passwords (min 12 characters). The values below are for local
# development only.
SEED_ADMIN_ENABLED=
SEED_ADMIN_EMAIL=admin@email.com
SEED_ADMIN_PASSWORD=Admin@123

# Email-confirmation / password-reset tokens (single-use). Delivery follows
# MAIL_TRANSPORT (see Mail below): log writes the token to the application log,
# smtp emails it — see docs/modules/users.md.
EMAIL_CONFIRMATION_TOKEN_TTL_HOURS=48
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# Admin change requests: when an admin edits another admin, the change waits for
# the target admin's approval and expires after this many hours (integer >= 1).
USER_CHANGE_REQUEST_TTL_HOURS=48

# Auth cookies (tokens travel in httpOnly cookies; CSRF via session-bound signed double-submit token)
# COOKIE_SECRET signs the auth cookies, the csrf_session cookie, and the CSRF token HMAC.
# COOKIE_SECURE must be set to true in production (HTTPS). COOKIE_SAMESITE: strict | lax | none;
# none is rejected unless COOKIE_SECURE=true.
# COOKIE_DOMAIN is optional (leave empty to scope to the current host).
COOKIE_SECRET=change-me-cookie-secret
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# CORS
# With cookie auth, credentials are enabled and the origin cannot be a wildcard — list explicit origins
# (comma-separated). When unset, defaults to the origin of APP_WEB_URL (the web app, not this API).
# Each entry must be an exact origin: scheme://host[:port], no path or trailing slash.
# A frontend on another site (not just another port or subdomain) also needs
# COOKIE_SAMESITE=none and COOKIE_SECURE=true; see docs/modules/auth.md.
CORS_ORIGINS=http://localhost:5173

# Rate limiting (TTL in seconds). THROTTLE_* is the global per-route budget.
# AUTH_THROTTLE_* replaces it on public credential and token routes (login,
# refresh, forgot/reset password, confirm-email, resend-confirmation) and
# defaults to 5 requests per 60 seconds. Every value must be an integer >= 1.
THROTTLE_TTL=60
THROTTLE_LIMIT=100
AUTH_THROTTLE_TTL=60
AUTH_THROTTLE_LIMIT=5
# Rate-limit counters live in process memory unless THROTTLE_REDIS_URL is set
# (redis:// or rediss://, credentials and database index allowed, e.g.
# redis://:password@host:6379/0). Set it whenever more than one API instance
# serves traffic, so every instance shares one budget per client. With Redis
# configured the API fails to boot if Redis does not answer, throttled routes return
# 503 while it is unreachable, and GET /api/health/ready checks it too.
# Local Redis: `docker compose --profile redis up`, then redis://localhost:6379
# (bare-metal API) or redis://redis:6379 (API in Compose).
THROTTLE_REDIS_URL=

# Logging (fatal | error | warn | info | debug | trace | silent)
LOG_LEVEL=info
# Human-readable dev output via pino-pretty (devDependency only). Keep off/unset in production.
LOG_PRETTY=false

# Mail (transport: log | smtp — log-only by default; smtp requires MAIL_HOST/MAIL_FROM)
# Production requires MAIL_TRANSPORT=smtp set explicitly.
# MAIL_PORT defaults to 587 (SMTP submission) when unset; the 1025 below targets the
# local mailpit container (`docker compose --profile mail up`), so set your provider's
# port (usually 587, or 465 with MAIL_SECURE=true) in a real deployment.
MAIL_TRANSPORT=log
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Spend Track <no-reply@example.com>"
MAIL_CONFIRM_EMAIL_PATH=/confirm-email
MAIL_RESET_PASSWORD_PATH=/reset-password
MAIL_USER_CHANGE_REQUEST_PATH=/account/change-requests

# Frontend base URL used to build email links (email confirmation / password reset / change requests)
APP_WEB_URL=http://localhost:5173

# Retention cleanup — scheduled jobs hard-delete technical rows once they are older
# than these windows (integers >= 0; 0 disables that job). Token windows count from expiry; log windows
# count from creation; email outbox jobs count from when they reached SENT or FAILED. Deletes run in batches of RETENTION_CLEANUP_BATCH_SIZE rows
# (1-10000), so a large backlog is drained without one long-running statement.
PASSWORD_RESET_TOKEN_RETENTION_DAYS=7
EMAIL_CONFIRMATION_TOKEN_RETENTION_DAYS=7
EMAIL_SEND_LOG_RETENTION_DAYS=30
EMAIL_OUTBOX_RETENTION_DAYS=7
AUDIT_LOG_RETENTION_DAYS=365
RETENTION_CLEANUP_BATCH_SIZE=1000

# Email send quotas — caps how many emails a single recipient address can trigger
# 0 disables that type. MAIL_DAILY_LIMIT_EMAIL_CHANGE_NOTICE=0 turns off the security notice
# sent to the previous address when a user changes their own email.
MAIL_DAILY_LIMIT_PASSWORD_RESET=5
MAIL_DAILY_LIMIT_EMAIL_CONFIRMATION=5
MAIL_DAILY_LIMIT_USER_CHANGE_REQUEST=5
MAIL_DAILY_LIMIT_EMAIL_CHANGE_NOTICE=5

# Email outbox — password-reset, email-confirmation, change-request and email-change notice emails
# are queued in Postgres and delivered by an in-process worker that polls every
# EMAIL_OUTBOX_POLL_INTERVAL_MS (10-60000). A failed attempt is retried with exponential backoff starting at
# EMAIL_OUTBOX_RETRY_BASE_DELAY_SECONDS (1-3600, capped at 1 hour) until
# EMAIL_OUTBOX_MAX_ATTEMPTS (1-20) attempts have run; the job is then marked FAILED.
# Set EMAIL_OUTBOX_WORKER_ENABLED=false on replicas that should only enqueue.
EMAIL_OUTBOX_WORKER_ENABLED=true
EMAIL_OUTBOX_POLL_INTERVAL_MS=5000
EMAIL_OUTBOX_MAX_ATTEMPTS=5
EMAIL_OUTBOX_RETRY_BASE_DELAY_SECONDS=60
