# Local development values. See docs/infrastructure.md for setup and production configuration.

# App
NODE_ENV=development
PORT=3000
DEFAULT_LOCALE=pt-BR

# Proxy trust: false for direct connections; otherwise use a hop count or trusted addresses.
TRUST_PROXY=false

# PostgreSQL (Compose overrides DB_HOST to postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=spend_track

# Managed PostgreSQL: enable TLS as required; see docs/infrastructure.md#managed-postgresql.
DB_SSL=false
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=0

# Auth (replace all secret placeholders in production)
# JWT TTL units: ms, s, m, h, d; a bare integer means milliseconds.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=7d

# Refresh-token retention in days; 0 disables cleanup.
REFRESH_TOKEN_RETENTION_DAYS=30

# Seed admin (local credentials only; production requires explicit opt-in)
SEED_ADMIN_ENABLED=
SEED_ADMIN_EMAIL=admin@email.com
SEED_ADMIN_PASSWORD=Admin@123

# Single-use tokens
EMAIL_CONFIRMATION_TOKEN_TTL_HOURS=48
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# Admin change-request expiry in hours
USER_CHANGE_REQUEST_TTL_HOURS=48

# Auth cookies (production requires secure cookies; SameSite=none also requires secure=true)
# Leave COOKIE_DOMAIN empty for host-only cookies.
COOKIE_SECRET=change-me-cookie-secret
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# CORS: comma-separated frontend origins, without paths, trailing slashes, or wildcards.
CORS_ORIGINS=http://localhost:5173

# Rate limiting (TTL in seconds); AUTH_* applies to credential and token routes.
THROTTLE_TTL=60
THROTTLE_LIMIT=100
AUTH_THROTTLE_TTL=60
AUTH_THROTTLE_LIMIT=5

# Shared rate limits: set a redis:// or rediss:// URL when running multiple API instances.
THROTTLE_REDIS_URL=

# Logging (fatal | error | warn | info | debug | trace | silent)
LOG_LEVEL=info

# Human-readable output for local development only.
LOG_PRETTY=false

# Mail: log for local output; production requires smtp. Port 1025 targets local Mailpit.
MAIL_TRANSPORT=log
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Spend Track <no-reply@spendtrack.com>"
MAIL_CONFIRM_EMAIL_PATH=/confirm-email
MAIL_RESET_PASSWORD_PATH=/reset-password
MAIL_USER_CHANGE_REQUEST_PATH=/account/change-requests

# Frontend base URL for email links
APP_WEB_URL=http://localhost:5173

# Retention in days; 0 disables each cleanup job. See docs/core.md#scheduling-and-retention.
PASSWORD_RESET_TOKEN_RETENTION_DAYS=7
EMAIL_CONFIRMATION_TOKEN_RETENTION_DAYS=7
EMAIL_SEND_LOG_RETENTION_DAYS=30
EMAIL_OUTBOX_RETENTION_DAYS=7
AUDIT_LOG_RETENTION_DAYS=365
RETENTION_CLEANUP_BATCH_SIZE=1000

# Daily emails per recipient and type; 0 disables that email type.
MAIL_DAILY_LIMIT_PASSWORD_RESET=5
MAIL_DAILY_LIMIT_EMAIL_CONFIRMATION=5
MAIL_DAILY_LIMIT_USER_CHANGE_REQUEST=5
MAIL_DAILY_LIMIT_EMAIL_CHANGE_NOTICE=5

# Email outbox (keep a worker enabled on at least one instance)
# Delivery and retries: docs/modules/email-outbox.md.
EMAIL_OUTBOX_WORKER_ENABLED=true
EMAIL_OUTBOX_POLL_INTERVAL_MS=5000
EMAIL_OUTBOX_MAX_ATTEMPTS=5
EMAIL_OUTBOX_RETRY_BASE_DELAY_SECONDS=60
